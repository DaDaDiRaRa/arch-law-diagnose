# ─── Anthropic ───────────────────────────────────────────────
# 진단의 정성 영역(설비·소방)·자연어 질의·조례 본문 수치 추출에 사용
ANTHROPIC_API_KEY=sk-ant-...

# ─── 법제처 DRF Open API ─────────────────────────────────────
# 조례 본문 수집(seed_municipal_ordinances), 시도/시군구 조례 변경 감지
LAW_API_KEY=...

# ─── VWorld OpenAPI ──────────────────────────────────────────
# 좌표 변환·용도지역·지적도·도로폭·지적 폴리곤(WFS)
VWORLD_API_KEY=...

# ─── 카카오 로컬 API (주소 자동완성) ─────────────────────────
# AddressSearch 컴포넌트의 실시간 자동완성
KAKAO_API_KEY=KakaoAK_...

# ─── 토지이음 API (Phase 0~3) ────────────────────────────────
# 법령정보(Phase 1) · 행정 고시(Phase 2) · 개발 인허가(Phase 3) · 행위제한
EUM_ID=...
EUM_KEY=...

# ─── 행안부 도로명주소 Open API ──────────────────────────────
# 주소 검색 폴백·정규화
JUSO_API_KEY=...

# ─── 공공데이터포털 (보조, 옵션) ────────────────────────────
# LURIS 행위제한 (legacy — 토지이음 행위제한과 교차검증용)
DATA_GO_KR_API_KEY=...

# ─── 앱 설정 ─────────────────────────────────────────────────
DB_PATH=./data/arch_law.db
CACHE_TTL_DAYS=30
LOG_LEVEL=INFO

# ─── 사내 케이스 DB ──────────────────────────────────────────
# 비워두면 프로젝트 루트의 KUNWON_DB/cases/ 사용
CASE_DB_PATH=

# ─── 시니어 검토 요청 (Slack) ───────────────────────────────
# 미설정 시 ./data/review_requests.log 에만 기록
SLACK_WEBHOOK_URL=
REVIEW_LOG_PATH=./data/review_requests.log

# ─── LLM 모델 override (선택) ────────────────────────────────
# 미설정 시 backend/services/llm_client.py 의 _DEFAULT_MODEL 사용
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── 법규 변경 Cron 자동화 (선택) ───────────────────────────
# ENABLE_LAW_CHANGE_CRON=true 면 매주 일요일 03:00 KST 자동 스캔
# LAW_CHANGE_CRON 으로 주기 변경 (cron 식, 미설정 시 기본 주기)
ENABLE_LAW_CHANGE_CRON=false
LAW_CHANGE_CRON=
