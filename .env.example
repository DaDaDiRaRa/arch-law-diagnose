
VWORLD_ROAD_LAYER=lt...
VWORLD_ROAD_WIDTH_FIELDS=wdth,...



# ─── Anthropic ───────────────────────────────────────────────
# 진단의 정성 영역(설비·소방)·자연어 질의·조례 본문 수치 추출에 사용
ANTHROPIC_API_KEY=sk-ant-...

# ─── 법제처 DRF Open API ─────────────────────────────────────
# 조례 본문 수집(seed_municipal_ordinances), 시도/시군구 조례 변경 감지
LAW_API_KEY=ii...

# ─── VWorld OpenAPI ──────────────────────────────────────────
# 좌표 변환·용도지역·지적도·도로폭·지적 폴리곤(WFS)
VWORLD_API_KEY=70A...

# ─── 카카오 로컬 API (주소 자동완성 + 교육환경평가 학교 근접 조회) ─
# AddressSearch 자동완성 + SchoolClient(SC4 카테고리 반경 검색)
# 추가 키 불필요 — 동일 키로 재사용
KAKAO_API_KEY=998...

# ─── 국가유산청 OpenAPI (문화재 현상변경 근접 판정) ────────────
# 지정문화재 500m 이내 여부를 GPS 좌표로 실시간 조회.
# 가입: https://www.heritage.go.kr → 공공데이터 → API 신청 (무료)
# 미설정 시 graceful degrade — 지역지구명 텍스트 단서 기반 판정으로 전환.
HERITAGE_API_KEY=

# ─── 토지이음 API (Phase 0~3) ────────────────────────────────
# 법령정보(Phase 1) · 행정 고시(Phase 2) · 개발 인허가(Phase 3) · 행위제한
EUM_ID=ju...
EUM_KEY=9SC...

# ─── 행안부 도로명주소 Open API ──────────────────────────────
# 주소 검색 폴백·정규화
JUSO_API_KEY=devU0...

# ─── 공공데이터포털 (보조, 옵션) ────────────────────────────
# LURIS 행위제한 (legacy — 토지이음 행위제한과 교차검증용)
DATA_GO_KR_API_KEY=56486...

# ─── 앱 설정 ─────────────────────────────────────────────────
DB_PATH=./data/...
# SHP 루트 — 미설정 시 프로젝트 루트의 files/3/shp 사용. 회사 PC 는 M 드라이브로 대형 정적 데이터 이전.
SHP_ROOT=M:\06_설계사...
CACHE_TTL_DAYS=...
LOG_LEVEL=...

# ─── 사내 케이스 DB ──────────────────────────────────────────
# 비워두면 프로젝트 루트의 KUNWON_DB/cases/ 사용
CASE_DB_PATH=

# ─── 공모지침 불러오기 (사업성 모드) ──────────────────────────
# Competition Analyzer가 저장한 brief json 들이 모인 디렉터리.
# 실제 버킷: kunwon-competition-db (asia-northeast3). brief 결과는 그 안의 _briefs/ 폴더에
#   {YYYYMMDD}_{HHMMSS}_{카테고리}.json (+ .md/.xlsx 형제)로 누적됨.
# Cloud Run: 버킷을 GCSFUSE로 마운트하고 그 _briefs/ 하위 경로를 지정 (버킷 루트 아님!).
#   예) BRIEF_DIR=/gcs/kunwon-competition-db/_briefs
# 로컬: brief json 파일들을 모아둔 폴더. 비워두면 ./data/briefs 사용.
BRIEF_DIR=

# ─── 시니어 검토 요청 (Slack) ───────────────────────────────
# 미설정 시 ./data/review_requests.log 에만 기록
SLACK_WEBHOOK_URL=
REVIEW_LOG_PATH=./data...

# ─── LLM 모델 override (선택) ────────────────────────────────
# 미설정 시 backend/services/llm_client.py 의 _DEFAULT_MODEL 사용
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── 법규 변경 Cron 자동화 (선택) ───────────────────────────
# ENABLE_LAW_CHANGE_CRON=true 면 매주 일요일 03:00 KST 자동 스캔
# LAW_CHANGE_CRON 으로 주기 변경 (cron 식, 미설정 시 기본 주기)
ENABLE_LAW_CHANGE_CRON=false
LAW_CHANGE_CRON=

LURIS_API_KEY=5648637...

# ─── 철도망 SHP (Spec 8 철도보호지구) ────────────────────────
# Geofabrik OSM(geofabrik.de) → south-korea-latest-free.shp.zip
#   압축 해제 후 gis_osm_railways_free_1.shp 를 files/railway/railway.shp 로 배치
# 미설정 시 files/railway/railway.shp 사용. SMB 환경이면 절대경로 권장.
RAILWAY_SHP_PATH=
# SHP 좌표계 (기본: EPSG:4326 WGS84 — Geofabrik OSM 기본값)
# 국토지리정보원 수치지형도: EPSG:5179 / 구 Bessel TM SHP: EPSG:5174
RAILWAY_SHP_CRS=EPSG:4326

# ─── 자매 앱 arch-law-graph 링크아웃 (선택, 프론트 빌드타임) ──
# 진단 카드·AI 답변의 "원문↗" 링크가 가리킬 graph 앱 주소.
# 코드 기본값 = 프로덕션 graph. 로컬 graph(8080)로 테스트할 때만 아래 설정.
# VITE_GRAPH_URL=http://localhost:8080

# ─── 자매 앱 arch-law-graph 조문 원문 그라운딩 (선택, 백엔드) ──
# AI 질의 답변 시 적용 조문 "본문"을 graph 에서 받아 LLM 환각을 막음(A안).
# 코드 기본값 = 프로덕션 graph. 로컬 graph(8001)로 테스트할 때만 아래 설정.
# 미가동/미보유 시 graceful degrade — 원문 없이 동작, 진단엔 영향 없음.
# GRAPH_API_URL=http://localhost:8001
GRAPH_API_TIMEOUT=10