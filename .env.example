# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── 법제처 DRF Open API ─────────────────────────────────────
LAW_API_KEY=...

# ─── VWorld OpenAPI ──────────────────────────────────────────
VWORLD_API_KEY=...

# ─── 카카오 로컬 API (주소 자동완성) ─────────────────────────
KAKAO_API_KEY=KakaoAK_...

# ─── 토지이음 API ────────────────────────────────────────────
EUM_ID=...
EUM_KEY=...

# ─── 행안부 도로명주소 Open API ──────────────────────────────
JUSO_API_KEY=...

# ─── 공공데이터포털 (보조, 옵션) ────────────────────────────
DATA_GO_KR_API_KEY=...

# ─── 앱 설정 ─────────────────────────────────────────────────
DB_PATH=./data/arch_law.db
CACHE_TTL_DAYS=30
LOG_LEVEL=INFO

# ─── Phase 4: 사내 케이스 DB ─────────────────────────────────
# 비워두면 프로젝트 루트의 KUNWON_DB/cases/ 사용
CASE_DB_PATH=

# ─── Phase 4: 시니어 검토 요청 (Slack) ──────────────────────
# 미설정 시 ./data/review_requests.log 에만 기록
SLACK_WEBHOOK_URL=
REVIEW_LOG_PATH=./data/review_requests.log

# ─── Phase 4: LLM 모델 override (선택) ───────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-5
