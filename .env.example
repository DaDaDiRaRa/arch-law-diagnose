
# ─── Anthropic ───────────────────────────────────────────────
# 진단의 정성 영역(설비·소방)·자연어 질의·조례 본문 수치 추출에 사용
ANTHROPIC_API_KEY=sk-ant-api03-...

# LLM 모델 override (선택) — 미설정 시 backend/services/llm_client.py 의 _DEFAULT_MODEL 사용
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── 법제처 DRF Open API ─────────────────────────────────────
# 조례 본문 수집(seed_municipal_ordinances), 시도/시군구 조례 변경 감지
LAW_API_KEY=...

# ─── VWorld OpenAPI ──────────────────────────────────────────
# 좌표 변환·용도지역·지적도·도로폭·지적 폴리곤(WFS)
VWORLD_API_KEY=...

# VWorld 도로폭 레이어 설정 (선택 — 기본값 그대로 사용해도 됨)
VWORLD_ROAD_LAYER=LT_L_FRSTCRCL
VWORLD_ROAD_WIDTH_FIELDS=wdth,road_width,rd_wth,wdth_clss,WDTH,ROAD_BT,ROA_WDTH

# ─── 카카오 로컬 API ──────────────────────────────────────────
# 주소 자동완성 + SchoolClient(교육환경평가 학교 근접 반경 검색)
# 두 용도 모두 동일 키 재사용
KAKAO_API_KEY=...

# ─── 국가유산 공간정보 Open API (문화재 현상변경 근접 판정) ────
# 인증키 불필요 — HeritageClient가 시작 시 좌표 자동 수확·캐시
# 조회 실패 시 지역지구명 텍스트 단서 기반 graceful degrade

# ─── 토지이음 API ─────────────────────────────────────────────
# 법령정보·행정 고시·개발 인허가·행위제한 조회
EUM_ID=...
EUM_KEY=...

# ─── 행안부 도로명주소 Open API ──────────────────────────────
# 주소 검색 폴백·정규화 (현재 Kakao로 충분히 동작, 폴백 미구현)
JUSO_API_KEY=...

# ─── 공공데이터포털 / LURIS ──────────────────────────────────
# LURIS 행위제한 (토지이음과 교차검증용)
# LURIS_API_KEY 우선, 없으면 DATA_GO_KR_API_KEY 로 fallback
LURIS_API_KEY=...
DATA_GO_KR_API_KEY=...

# ─── 앱 설정 ─────────────────────────────────────────────────
DB_PATH=./data/arch_law.db
CACHE_TTL_DAYS=30
# 행위제한은 변경 빈도 낮음 — 기본 90일
LURIS_TTL_DAYS=90
LOG_LEVEL=INFO

# ─── SHP 파일 경로 ────────────────────────────────────────────
# 도시계획시설 SHP 루트 (회사 PC 기준 경로 — 새 로컬에서 맞게 변경)
# 미설정 시 프로젝트 루트의 files/3/shp 사용
# 회사 PC(M 드라이브): M:\06_설계사업6본부\설계사업6본부 1소\01 개인폴더\16 김정현\arch-law-shared\files\3\shp
SHP_ROOT=

# 철도망 SHP (Geofabrik OSM → gis_osm_railways_free_1.shp → files/railway/railway.shp 배치)
# 미설정 시 files/railway/railway.shp 사용
RAILWAY_SHP_PATH=
# 좌표계 — Geofabrik OSM 기본: EPSG:4326 / 국토지리정보원 수치지형도: EPSG:5179
RAILWAY_SHP_CRS=EPSG:4326

# ─── 법규 그래프 큐레이션 영속 경로 (선택) ──────────────────
# 탐색기 승격/반려 저장 위치 (law_graph_curation.json)
# Cloud Run: GCSFUSE 마운트 경로 지정 필요 (예: /gcs/<버킷>/law_graph)
# 미설정 시 repo backend/config/ 사용 (로컬→커밋→배포 흐름)
LAW_GRAPH_CURATION_DIR=

# ─── 공모지침 불러오기 (사업성 모드) ──────────────────────────
# Competition Analyzer 출력 brief JSON 들이 모인 디렉터리
# Cloud Run: GCSFUSE 마운트 후 _briefs/ 하위 경로 지정
#   예) BRIEF_DIR=/gcs/kunwon-competition-db/_briefs
# 로컬: brief json 파일들을 모아둔 폴더. 미설정 시 ./data/briefs 사용
BRIEF_DIR=

# ─── 시니어 검토 요청 (Slack) ───────────────────────────────
# 미설정 시 REVIEW_LOG_PATH 파일에만 기록
SLACK_WEBHOOK_URL=
REVIEW_LOG_PATH=./data/review_requests.log

# ─── 법규 변경 Cron 자동화 (선택) ───────────────────────────
# true 면 매주 일요일 03:00 KST 자동 스캔
ENABLE_LAW_CHANGE_CRON=false
LAW_CHANGE_CRON=
LAW_CHANGE_TZ=Asia/Seoul

# ─── 자매 앱 arch-law-graph 연동 (선택) ─────────────────────
# "원문↗" 링크가 가리킬 graph 앱 주소 (프론트 빌드타임 변수)
# 미설정 시 코드 기본값(프로덕션 graph) 사용
# 로컬 graph(8080) 테스트 시에만 아래 주석 해제
# VITE_GRAPH_URL=http://localhost:8080

# AI 질의 조문 원문 그라운딩 — graph에서 조문 본문을 받아 LLM 환각 방지(A안)
# 미설정·미가동 시 graceful degrade (진단에 영향 없음)
# 로컬 graph(8001) 테스트 시에만 아래 주석 해제
# GRAPH_API_URL=http://localhost:8001
GRAPH_API_TIMEOUT=10

# ─── 백엔드 서비스 URL (선택) ────────────────────────────────
# VWorld 클라이언트 내부 서비스 URL (로컬 기본값 그대로 유지)
SERVICE_URL=http://localhost:8000
